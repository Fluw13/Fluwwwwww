# Copy to backend/.env for local development. Never commit the real .env.
PORT=5000

# Google AI Studio key. Leave empty to run without AI analysis (aiAvailable=false).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Must stay well below the app's 75s client timeout (OFF uses up to 10s).
GEMINI_TIMEOUT_MS=25000

# Contact email sent in the OpenFoodFacts User-Agent. Use a mailbox you own.
# When empty, the User-Agent falls back to the project's GitHub URL.
OFF_CONTACT_EMAIL=

# Comma-separated list. Leave empty to allow every origin.
ALLOWED_ORIGINS=

RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500
