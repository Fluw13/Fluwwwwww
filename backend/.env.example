PORT=5000
# USDA FoodData Central key (free). Without it, search only uses Open Food Facts.
USDA_API_KEY=
# Google Gemini API key (free tier, no billing). Without it, photo recognition answers 503 and the app suggests searching by name.
GEMINI_API_KEY=
# Optional: another Gemini model with image input; defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional: server-wide caps on photo recognition for all users together (defaults 8 per minute, 200 per day,
# 4 at once). Keep them below the key's free quota; over a cap the app is told the service is busy.
GEMINI_MAX_PER_MINUTE=
GEMINI_MAX_PER_DAY=
GEMINI_MAX_CONCURRENT=
