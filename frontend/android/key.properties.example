# Mẫu cấu hình ký app release.
# Cách dùng: copy file này thành android/key.properties rồi điền giá trị thật.
# KHÔNG commit key.properties và KHÔNG commit file .jks (đã có trong .gitignore).
storePassword=<MẬT_KHẨU_KEYSTORE_MỚI>
keyPassword=<MẬT_KHẨU_KEY_MỚI>
keyAlias=upload
storeFile=upload-keystore.jks
